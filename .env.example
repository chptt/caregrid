# CareGrid Environment Configuration
# Copy to .env and fill in values.
# Never commit .env to source control.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# CORS / CSRF
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production examples:
# CORS_ALLOWED_ORIGINS=https://caregrid.vercel.app,https://app.caregrid.com
# CORS_ALLOWED_ORIGIN_REGEXES=https://caregrid-.*\.vercel\.app
# CSRF_TRUSTED_ORIGINS=https://caregrid.vercel.app,https://api.caregrid.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Option A — single URL (recommended, used by Railway / Render / Neon)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option B — individual variables
DB_NAME=caregrid
DB_USER=caregrid
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require          # disable for local dev without SSL
DB_CONN_MAX_AGE=60          # persistent connections (seconds)

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Option A — single URL (recommended)
# REDIS_URL=redis://:password@host:6379/0

# Option B — individual variables
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Blockchain
# ---------------------------------------------------------------------------
BLOCKCHAIN_PROVIDER_URL=http://127.0.0.1:8545
BLOCKCHAIN_NETWORK_ID=31337
BLOCKCHAIN_GAS_LIMIT=500000
BLOCKCHAIN_CONFIRMATION_TIMEOUT=30

# Contract addresses (populated after deployment)
CONTRACT_PATIENT_REGISTRY_ADDRESS=
CONTRACT_BLOCKED_IP_ADDRESS=
CONTRACT_ATTACK_SIGNATURE_ADDRESS=

# ---------------------------------------------------------------------------
# Security thresholds
# ---------------------------------------------------------------------------
THREAT_SCORE_MEDIUM=40
THREAT_SCORE_HIGH=61
RATE_LIMIT_UNAUTHENTICATED=100
RATE_LIMIT_AUTHENTICATED=500
AUTO_BLOCK_DURATION=86400
CAPTCHA_FAILURE_BLOCK_DURATION=900
CAPTCHA_MAX_FAILURES=3

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
AI_LLM_PROVIDER=openai          # openai | gemini | ollama
AI_LLM_MODEL=gpt-4o-mini
AI_LLM_API_KEY=                  # required for openai / gemini
AI_EMBEDDING_PROVIDER=local      # local | openai
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_EMBEDDING_DIMENSION=384
AI_MAX_UPLOAD_SIZE_MB=10
AI_OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Email (production only — for admin error emails)
# ---------------------------------------------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@caregrid.com
# ADMIN_EMAIL=admin@caregrid.com

# ---------------------------------------------------------------------------
# HTTPS (uncomment for production)
# ---------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
