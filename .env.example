# CareGrid Environment Configuration
# Copy this file to .env and fill in the values.

# Django Configuration
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Blockchain Configuration
BLOCKCHAIN_PROVIDER_URL=http://127.0.0.1:8545
BLOCKCHAIN_NETWORK_ID=31337
BLOCKCHAIN_GAS_LIMIT=500000
BLOCKCHAIN_CONFIRMATION_TIMEOUT=30

# Contract Addresses (populated after deployment)
CONTRACT_PATIENT_REGISTRY_ADDRESS=
CONTRACT_BLOCKED_IP_ADDRESS=
CONTRACT_ATTACK_SIGNATURE_ADDRESS=

# Security Configuration
THREAT_SCORE_MEDIUM=40
THREAT_SCORE_HIGH=61

# Rate Limiting
RATE_LIMIT_UNAUTHENTICATED=100
RATE_LIMIT_AUTHENTICATED=500

# Auto-blocking Configuration
AUTO_BLOCK_DURATION=86400
CAPTCHA_FAILURE_BLOCK_DURATION=900
CAPTCHA_MAX_FAILURES=3

# Logging
LOG_LEVEL=INFO

# Production Settings (uncomment for production)
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
